generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum LoginOutcome {
  SUCCESS
  INVALID_CREDENTIALS
  ACCOUNT_LOCKED
  ACCOUNT_INACTIVE
}

// Emails are unique for the table's whole life, deleted rows included: a soft-deleted account keeps its address
// so its audit trail stays unambiguous. The utf8mb4_unicode_ci collation makes the index case-insensitive.
model User {
  id                 String     @id @default(uuid()) @db.Char(36)
  email              String     @unique @db.VarChar(254)
  passwordHash       String     @map("password_hash") @db.VarChar(255)
  firstName          String     @map("first_name") @db.VarChar(100)
  lastName           String     @map("last_name") @db.VarChar(100)
  status             UserStatus @default(ACTIVE)
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.DateTime(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.DateTime(3)
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.DateTime(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt          DateTime?  @map("deleted_at") @db.DateTime(3)
  departmentId       String?    @map("department_id") @db.Char(36)

  department          Department?          @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: Restrict)
  managedDepartments  Department[]         @relation("DepartmentManager")
  roles               UserRole[]           @relation("UserRoles")
  assignedRoles       UserRole[]           @relation("UserRoleAssigner")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  activityLogs        ActivityLog[]
  loginHistory        LoginHistory[]

  @@index([status, deletedAt])
  @@index([lastName, firstName])
  @@index([createdAt])
  @@index([departmentId])
  @@map("users")
}

// An organisational unit. Code and name stay unique deleted rows included, like role names: a deletion renames them
// so they can be reused (see DepartmentsService.remove).
model Department {
  id          String    @id @default(uuid()) @db.Char(36)
  code        String    @unique @db.VarChar(80)
  name        String    @unique @db.VarChar(160)
  description String?   @db.VarChar(500)
  managerId   String?   @map("manager_id") @db.Char(36)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)

  manager User?  @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  members User[] @relation("DepartmentMembers")

  @@index([deletedAt])
  @@index([managerId])
  @@map("departments")
}

model Role {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(500)
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)

  users       UserRole[]
  permissions RolePermission[]

  @@index([deletedAt])
  @@map("roles")
}

// Permissions are reference data owned by the code (permission-catalog.ts): no soft delete.
model Permission {
  id          String  @id @default(uuid()) @db.Char(36)
  key         String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Char(36)
  roleId       String   @map("role_id") @db.Char(36)
  assignedById String?  @map("assigned_by_id") @db.Char(36)
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.DateTime(3)

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Only the SHA-256 of the opaque token is stored. family_id groups a rotation chain so a replayed token
// revokes the whole family.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  familyId     String    @map("family_id") @db.Char(36)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)
  replacedById String?   @unique @map("replaced_by_id") @db.Char(36)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("password_reset_tokens")
}

// Append-only: the API exposes no update or delete. metadata is scrubbed of secrets before insert.
model ActivityLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String?  @map("actor_id") @db.Char(36)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(36)
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

// email is the address typed at login, kept even when no account matches, to spot credential stuffing.
model LoginHistory {
  id        String       @id @default(uuid()) @db.Char(36)
  userId    String?      @map("user_id") @db.Char(36)
  email     String       @db.VarChar(254)
  outcome   LoginOutcome
  ipAddress String?      @map("ip_address") @db.VarChar(45)
  userAgent String?      @map("user_agent") @db.VarChar(255)
  createdAt DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([outcome, createdAt])
  @@map("login_history")
}
