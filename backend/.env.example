# Copy to .env (development) and .env.test (tests, database access_manager_test). Never commit the copies.
DATABASE_URL="mysql://access_manager:change-me@127.0.0.1:3310/access_manager"
SHADOW_DATABASE_URL="mysql://access_manager:change-me@127.0.0.1:3310/access_manager_shadow"

# Super admin created by `npm run db:seed`. At least 12 characters; never reused, never committed.
SEED_SUPER_ADMIN_EMAIL="superadmin@example.org"
SEED_SUPER_ADMIN_PASSWORD="change-me-at-least-12-chars"
SEED_SUPER_ADMIN_FIRST_NAME="Super"
SEED_SUPER_ADMIN_LAST_NAME="Administrateur"

NODE_ENV=development
PORT=3000
CORS_ORIGINS="http://localhost:5180"
APP_URL="http://localhost:5180"

# Generate with: openssl rand -hex 32 (the API refuses to start with this placeholder or a shorter secret).
JWT_ACCESS_SECRET="change-me-generate-with-openssl-rand-hex-32"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Failures from one IP on one account block that IP only (LOGIN_MAX_ATTEMPTS); the whole account locks after this many from all IPs.
LOGIN_ACCOUNT_MAX_ATTEMPTS=50
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60
PASSWORD_RESET_TTL_MINUTES=30

SMTP_HOST="127.0.0.1"
SMTP_PORT=1026
MAIL_FROM="Access Manager <no-reply@access-manager.local>"
SMTP_SECURE=false
# Set to true outside a workstation so reset links never travel in clear text.
SMTP_REQUIRE_TLS=false

# Logs: JSON lines on stdout (fatal, error, warn, info, debug, trace, silent).
LOG_LEVEL=info
# Per-IP limit on every route, per minute.
GLOBAL_THROTTLE_LIMIT=300
# Express trust proxy: false on a workstation, 1 behind one ingress or reverse proxy. Never "true".
TRUST_PROXY=false
# Swagger UI at /api/docs; false in production.
SWAGGER_ENABLED=true

# BullMQ job store (docker compose redis service). Tests use another database index (/1).
REDIS_URL="redis://127.0.0.1:6381/0"
# First retry delay of a failed notification job (exponential backoff, 5 attempts).
NOTIFICATION_RETRY_DELAY_MS=30000
