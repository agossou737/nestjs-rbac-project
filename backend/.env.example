# Copy to .env (development) and .env.test (tests, database access_manager_test). Never commit the copies.
DATABASE_URL="mysql://access_manager:change-me@127.0.0.1:3310/access_manager"
SHADOW_DATABASE_URL="mysql://access_manager:change-me@127.0.0.1:3310/access_manager_shadow"

# Super admin created by `npm run db:seed`. At least 12 characters; never reused, never committed.
SEED_SUPER_ADMIN_EMAIL="superadmin@example.org"
SEED_SUPER_ADMIN_PASSWORD="change-me-at-least-12-chars"
SEED_SUPER_ADMIN_FIRST_NAME="Super"
SEED_SUPER_ADMIN_LAST_NAME="Administrateur"
