# docker-compose variables. Copy to .env and replace every change-me value.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=access_manager
MYSQL_USER=access_manager
MYSQL_PASSWORD=change-me
MYSQL_PORT=3310
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# Whole-stack run (docker compose up -d --build): the application is served on http://localhost:FRONTEND_PORT.
FRONTEND_PORT=8088
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-hex-32
# Super admin created by: docker compose exec backend npx prisma db seed
SEED_SUPER_ADMIN_EMAIL=superadmin@example.org
SEED_SUPER_ADMIN_PASSWORD=change-me-at-least-12-chars
SWAGGER_ENABLED=false
